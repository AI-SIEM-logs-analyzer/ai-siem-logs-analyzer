# Local overrides for `./mvnw quarkus:dev` on the host.
#   cp backend/.env.example backend/.env
# Quarkus loads backend/.env automatically in dev mode. The real .env is git-ignored —
# put secrets there, never in application.yaml.
#
# Naming rule: a config key becomes an environment variable by uppercasing it and
# replacing dots and dashes with underscores (app.ai.api-key -> APP_AI_API_KEY).
# These entries outrank application.yaml, so anything set here wins.

# --- Secrets ---
# API key for the AI provider. The dev profile ships a placeholder, so this is only
# needed once the application talks to the provider for real.
APP_AI_API_KEY=dev-placeholder

# --- Optional overrides ---
# Name reported by /q/health/ready. Defaults to the active profile's value.
# APP_ENVIRONMENT=dev

# Port the dev server binds to. Change it when 8080 is taken by the Compose stack.
# QUARKUS_HTTP_PORT=8080

# Raise or lower log verbosity for application code (dev defaults to DEBUG).
# QUARKUS_LOG_CATEGORY__COM_SIEM__LEVEL=INFO
