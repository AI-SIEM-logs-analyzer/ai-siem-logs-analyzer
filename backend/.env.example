# Local overrides for `./mvnw quarkus:dev` on the host.
#   cp backend/.env.example backend/.env
# Quarkus loads backend/.env automatically in dev mode. The real .env is git-ignored —
# put secrets there, never in application.yaml.
#
# Naming rule: a config key becomes an environment variable by uppercasing it and
# replacing dots and dashes with underscores (app.ai.api-key -> APP_AI_API_KEY).
# These entries outrank application.yaml, so anything set here wins.

# --- Secrets ---
# API key for the AI provider. The dev profile ships a placeholder, so this is only
# needed once the application talks to the provider for real.
APP_AI_API_KEY=dev-placeholder

# --- Optional overrides ---
# Name reported by /q/health/ready. Defaults to the active profile's value.
# APP_ENVIRONMENT=dev

# Port the dev server binds to. Change it when 8080 is taken by the Compose stack.
# QUARKUS_HTTP_PORT=8080

# Raise or lower log verbosity for application code (dev defaults to DEBUG).
# QUARKUS_LOG_CATEGORY__COM_SIEM__LEVEL=INFO

# Database the dev profile connects to. It defaults to the Compose stack
# (jdbc:postgresql://localhost:5432/siem, user siem), so `make up` plus `./mvnw quarkus:dev`
# needs nothing here. Set POSTGRES_PASSWORD if you changed it in docker/.env.
# POSTGRES_PASSWORD=siem_local_dev
# QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/siem

# --- Tokens ---
# The dev profile signs with the committed throwaway pair in backend/dev-keys/, so nothing is
# needed here. Set these only to point the dev server at a different pair.
# SMALLRYE_JWT_SIGN_KEY_LOCATION=file:./dev-keys/privateKey.pem
# MP_JWT_VERIFY_PUBLICKEY_LOCATION=file:./dev-keys/publicKey.pem

# Identifies this deployment as the minter of a token; the verifier demands the same value.
# APP_AUTH_ISSUER=https://siem-analyzer.local/auth

# How long a token pair lives. ISO-8601 durations.
# APP_AUTH_ACCESS_TTL=PT15M
# APP_AUTH_REFRESH_TTL=P14D

# First password for the seeded 'admin' account, whose stored hash matches no password until
# one is set. Applied at start-up and ignored once the account has a password, so it can stay
# here. Change the password after the first sign-in.
# APP_AUTH_BOOTSTRAP_PASSWORD=

# --- Redis ---
# Refresh tokens, the logout deny-list and the login rate limiter. Defaults to the Compose
# stack; set this if you changed REDIS_PASSWORD in docker/.env.
# REDIS_PASSWORD=siem_local_dev
