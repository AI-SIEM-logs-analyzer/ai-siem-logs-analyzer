{
  // The application in src/. Type checking only — Vite does the transpiling, so nothing
  // here emits JavaScript. vite.config.ts runs in Node and is checked by tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // Strict by default: it is far cheaper to start here than to retrofit later.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // Third-party .d.ts files are not ours to fix; checking them only adds noise.
    "skipLibCheck": true,

    // `@/…` resolves to src/ — the alias shadcn/ui generates imports against. Vite gets the
    // same mapping in vite.config.ts.
    "paths": { "@/*": ["./src/*"] },
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src"]
}
