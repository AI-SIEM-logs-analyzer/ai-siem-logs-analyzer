{
  "openapi" : "3.1.0",
  "components" : {
    "schemas" : {
      "ChangePasswordRequest" : {
        "type" : "object",
        "required" : [ "password" ],
        "properties" : {
          "password" : {
            "type" : "string",
            "pattern" : "\\S",
            "minLength" : 12,
            "maxLength" : 128
          }
        }
      },
      "CreateUserRequest" : {
        "type" : "object",
        "required" : [ "username", "password", "roles" ],
        "properties" : {
          "username" : {
            "type" : "string",
            "pattern" : "^[a-z0-9](?:[a-z0-9._-]{1,62}[a-z0-9])$"
          },
          "email" : {
            "type" : "string",
            "maxLength" : 254
          },
          "password" : {
            "type" : "string",
            "pattern" : "\\S",
            "minLength" : 12,
            "maxLength" : 128
          },
          "roles" : {
            "type" : "array",
            "uniqueItems" : true,
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "minItems" : 1
          }
        }
      },
      "EventFacets" : {
        "type" : "object",
        "properties" : {
          "bySeverity" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int64"
            }
          },
          "bySourceId" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int64"
            }
          },
          "byHost" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int64"
            }
          },
          "bySrcIp" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int64"
            }
          },
          "overTime" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TimeBucket"
            }
          }
        }
      },
      "EventHit" : {
        "type" : "object",
        "description" : "One matching event",
        "properties" : {
          "eventId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "sourceId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "occurredAt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "ingestedAt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "severity" : {
            "$ref" : "#/components/schemas/Severity",
            "type" : "object"
          },
          "message" : {
            "type" : "string"
          },
          "raw" : {
            "type" : "string"
          },
          "fields" : {
            "type" : "object",
            "additionalProperties" : { },
            "description" : "Standard parsed fields present on this event, in camelCase: host, srcIp, status, method, path, ..., and when the source address was enriched: geoCountryIso, geoCountryName, geoCity, geoLatitude, geoLongitude, geoAsn, geoAsOrg; and when the User-Agent was classified: uaBrowser, uaBrowserVersion, uaOs, uaOsVersion, uaDeviceClass, uaAgentClass, uaBot (a boolean)"
          }
        }
      },
      "EventSearchResponse" : {
        "description" : "One page of matching events",
        "type" : "object",
        "properties" : {
          "hits" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/EventHit"
            }
          },
          "totalHits" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Events matching the filters across all pages"
          },
          "nextCursorOccurredAt" : {
            "description" : "Send back as cursorOccurredAt for the next page; null on the last page",
            "type" : [ "string", "null" ],
            "anyOf" : [ {
              "$ref" : "#/components/schemas/Instant"
            }, {
              "type" : "null"
            } ]
          },
          "nextCursorEventId" : {
            "type" : [ "integer", "null" ],
            "format" : "int64",
            "description" : "Send back as cursorEventId for the next page; null on the last page"
          },
          "facets" : {
            "description" : "Aggregations over the whole match; empty unless facets=true",
            "type" : "object",
            "$ref" : "#/components/schemas/EventFacets"
          }
        }
      },
      "Instant" : {
        "type" : "string",
        "format" : "date-time",
        "examples" : [ "2022-03-10T16:15:50Z" ]
      },
      "LogFormat" : {
        "type" : "string",
        "enum" : [ "JSON", "SYSLOG", "CEF", "CSV", "ACCESS_LOG", "PLAIN" ]
      },
      "LogSourceType" : {
        "type" : "string",
        "enum" : [ "SYSLOG", "FIREWALL", "CLOUD_TRAIL", "APPLICATION", "ENDPOINT" ]
      },
      "LogUploadResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "sourceId" : {
            "type" : "integer",
            "format" : "int64"
          },
          "sourceName" : {
            "type" : "string"
          },
          "fileName" : {
            "type" : "string"
          },
          "contentType" : {
            "type" : "string"
          },
          "detectedFormat" : {
            "$ref" : "#/components/schemas/LogFormat"
          },
          "fileSize" : {
            "type" : "integer",
            "format" : "int64"
          },
          "checksum" : {
            "type" : "string"
          },
          "status" : {
            "$ref" : "#/components/schemas/LogUploadStatus"
          },
          "storagePath" : {
            "type" : "string"
          },
          "uploadedBy" : {
            "type" : "string"
          },
          "uploadedById" : {
            "type" : "integer",
            "format" : "int64"
          },
          "createdAt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "processingStartedAt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "processedAt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "eventCount" : {
            "type" : "integer",
            "format" : "int64"
          },
          "errorMessage" : {
            "type" : "string"
          },
          "updatedAt" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }
      },
      "LogUploadStatus" : {
        "type" : "string",
        "enum" : [ "PENDING", "PROCESSING", "INGESTED", "FAILED" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "required" : [ "username", "password" ],
        "properties" : {
          "username" : {
            "type" : "string",
            "pattern" : "\\S"
          },
          "password" : {
            "type" : "string",
            "pattern" : "\\S"
          }
        }
      },
      "PageResponseLogUploadResponse" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LogUploadResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "total" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "RefreshRequest" : {
        "type" : "object",
        "required" : [ "refreshToken" ],
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "pattern" : "\\S"
          }
        }
      },
      "Role" : {
        "type" : "string",
        "enum" : [ "ADMIN", "ANALYST", "VIEWER" ]
      },
      "Severity" : {
        "type" : "string",
        "enum" : [ "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL" ]
      },
      "TimeBucket" : {
        "type" : "object",
        "properties" : {
          "start" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "count" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "tokenType" : {
            "type" : "string"
          },
          "expiresIn" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "UpdateUserRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254
          },
          "roles" : {
            "type" : "array",
            "uniqueItems" : true,
            "items" : {
              "$ref" : "#/components/schemas/Role"
            },
            "minItems" : 1
          },
          "enabled" : {
            "type" : "boolean"
          }
        },
        "required" : [ "roles" ]
      },
      "UserResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "username" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "roles" : {
            "type" : "array",
            "uniqueItems" : true,
            "items" : {
              "$ref" : "#/components/schemas/Role"
            }
          },
          "enabled" : {
            "type" : "boolean"
          },
          "passwordSet" : {
            "type" : "boolean"
          },
          "createdAt" : {
            "$ref" : "#/components/schemas/Instant"
          },
          "updatedAt" : {
            "$ref" : "#/components/schemas/Instant"
          }
        }
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "checks" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/HealthCheck"
            }
          },
          "status" : {
            "type" : "string",
            "enum" : [ "UP", "DOWN" ]
          }
        }
      },
      "HealthCheck" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "type" : [ "object", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "UP", "DOWN" ]
          }
        }
      }
    },
    "securitySchemes" : {
      "SecurityScheme" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT",
        "description" : "Authentication"
      }
    }
  },
  "paths" : {
    "/api/auth/login" : {
      "post" : {
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "summary" : "Login",
        "tags" : [ "Auth Resource" ]
      }
    },
    "/api/auth/logout" : {
      "post" : {
