              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : { }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "summary" : "Logout",
        "tags" : [ "Auth Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Not Authorized"
          },
          "403" : {
            "description" : "Not Allowed"
          }
        },
        "summary" : "Me",
        "tags" : [ "Auth Resource" ],
        "security" : [ {
          "SecurityScheme" : [ ]
        } ]
      }
    },
    "/api/auth/refresh" : {
      "post" : {
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Bad Request"
          }
        },
        "summary" : "Refresh",
        "tags" : [ "Auth Resource" ]
      }
    },
    "/api/events/search" : {
      "get" : {
        "summary" : "Search events",
        "description" : "Filters combine with AND; the values of one repeated parameter combine with OR. Results are sorted by event time, with the event id breaking ties, and paged by cursor: pass nextCursorOccurredAt and nextCursorEventId from a response back as cursorOccurredAt and cursorEventId, with the same filters and order, to get the next page. A null next cursor means the last page.",
        "operationId" : "searchEvents",
        "tags" : [ "Events" ],
        "parameters" : [ {
          "description" : "Resume after this event id; send together with cursorOccurredAt",
          "name" : "cursorEventId",
          "in" : "query",
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "description" : "Resume after this event time; send together with cursorEventId",
          "name" : "cursorOccurredAt",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Also count severities, sources, hosts, source IPs and events per hour across the whole match",
          "name" : "facets",
          "in" : "query",
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "description" : "Earliest event time, inclusive (ISO-8601 instant)",
          "example" : "2026-09-01T00:00:00Z",
          "name" : "from",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Direction of the event-time sort",
          "schema" : {
            "type" : "string",
            "default" : "desc",
            "enum" : [ "asc", "desc" ]
          },
          "name" : "order",
          "in" : "query"
        }, {
          "description" : "Full-text search over the message",
          "example" : "failed login",
          "name" : "q",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Restrict to these severities; repeatable",
          "schema" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Severity"
            }
          },
          "name" : "severity",
          "in" : "query"
        }, {
          "description" : "Hits per page",
          "schema" : {
            "maximum" : 1000,
            "minimum" : 1,
            "type" : "integer",
            "default" : 50
          },
          "name" : "size",
          "in" : "query"
        }, {
          "description" : "Restrict to these log sources; repeatable",
          "name" : "sourceId",
          "in" : "query",
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "integer",
              "format" : "int64"
            }
          }
        }, {
          "description" : "Source IP address or CIDR range, IPv4 or IPv6; repeatable, at most 50",
          "example" : "10.0.0.0/8",
          "name" : "srcIp",
          "in" : "query",
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }, {
          "description" : "HTTP status code (404) or class (5xx); repeatable, at most 50. Events without a status never match.",
          "example" : "5xx",
          "name" : "status",
          "in" : "query",
          "schema" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          }
        }, {
          "description" : "Literal, case-insensitive substring of the raw line; at most 256 characters",
          "example" : "192.168.1.",
          "name" : "substring",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Latest event time, exclusive (ISO-8601 instant)",
          "example" : "2026-09-02T00:00:00Z",
          "name" : "to",
          "in" : "query",
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "One page of matching events",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventSearchResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "A parameter is malformed or exceeds a limit"
          },
          "401" : {
            "description" : "No valid access token"
          },
          "403" : {
            "description" : "The caller's roles do not allow searching"
          },
          "503" : {
            "description" : "The search index is unreachable; ingestion continues"
          }
        },
        "security" : [ {
          "SecurityScheme" : [ "ADMIN", "ANALYST", "VIEWER" ]
        } ]
      }
    },
    "/api/logs/upload" : {
