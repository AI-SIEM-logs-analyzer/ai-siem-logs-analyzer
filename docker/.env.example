# Copy to docker/.env before the first `docker compose up`.
#   cp docker/.env.example docker/.env
# Local development values only — never reuse these credentials anywhere else.

COMPOSE_PROJECT_NAME=siem

# --- PostgreSQL ---
POSTGRES_DB=siem
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem_local_dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=redis_local_dev
REDIS_PORT=6379

# --- Redpanda (Kafka-compatible, single node) ---
REDPANDA_VERSION=v24.2.7
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644

# --- Backend (profile: app) ---
# The container runs the prod profile, which carries no secrets of its own — they are
# passed in from here. Host-side dev (`./mvnw quarkus:dev`) reads backend/.env instead.
BACKEND_IMAGE=siem/security-log-analyzer-backend
BACKEND_TAG=0.1.0-SNAPSHOT
BACKEND_PORT=8080
# API key for the AI provider. Compose refuses to start the backend without it.
APP_AI_API_KEY=local-placeholder
# Name reported by /q/health/ready. Handy for telling stacks apart.
APP_ENVIRONMENT=local-compose
# The backend's datasource is assembled from the PostgreSQL variables above; there is
# nothing extra to set here. Override QUARKUS_DATASOURCE_JDBC_URL directly only when
# pointing the container at a database outside this stack.

# --- Redpanda Console (profile: tools) ---
REDPANDA_CONSOLE_VERSION=v2.7.2
REDPANDA_CONSOLE_PORT=8085
